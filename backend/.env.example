# Backend Environment Variables Template
PORT=5000
JWT_SECRET=your-secret-jwt-key

# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/finvest?retryWrites=true&w=majority
# Local Example: mongodb://localhost:27017/finvest
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/finvest?retryWrites=true&w=majority
